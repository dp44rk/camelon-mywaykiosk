# Air API (https://docs.aieev.com/docs/ko/air-api)
# 각 모델 카드의 "코드 보기"에서 endpoint id / model id를 확인해 맞게 고치세요.
AIR_API_KEY=
AIR_BASE=https://ap-1.aieev.cloud/endpoints

# 화면 보기 (이미지 입력 지원 모델: Qwen3.8-27B, Qwen3.5-9B)
VISION_ENDPOINT=qwen3-8-27b
VISION_MODEL=qwen/qwen3.8-27b
# 빠른 대안 (이미지 1장): VISION_ENDPOINT=qwen3-5-9b  VISION_MODEL=qwen/qwen3.5-9b

# 글 다듬기·목표 이해 (빠른 텍스트 모델)
TEXT_ENDPOINT=deepseek-v4-1-flash-poc-1017
TEXT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017

# 음성 (Qwen3-TTS)
TTS_ENDPOINT=qwen3-tts
TTS_MODEL=qwen/qwen3-tts-customvoice
TTS_VOICE=Sohee

PORT=8787
# 키 없이 화면만 보고 싶을 때: MOCK_AI=1
MOCK_AI=0
